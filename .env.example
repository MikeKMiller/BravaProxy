# Copy to .env and fill in your values
# Never commit .env

TECHNITIUM_URL=http://127.0.0.1:5380
TECHNITIUM_USER=admin
TECHNITIUM_PASS=yourpassword

# LAN IP of the machine running mitmproxy (this machine)
PROXY_IP=10.10.x.x

# Brava oven's LAN IP — used to filter Technitium query logs
BRAVA_OVEN_IP=10.10.254.144
